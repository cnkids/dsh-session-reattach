{
  "name": "dsh-session-reattach",
  "version": "0.1.1",
  "description": "会话归位：把游离（未分组）会话按 canonical cwd 重新归属到匹配的工作区，只修 workspace 归属记录，不动会话文件。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnkids/dsh-session-reattach.git"
  },
  "homepage": "https://github.com/cnkids/dsh-session-reattach#readme",
  "bugs": {
    "url": "https://github.com/cnkids/dsh-session-reattach/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'test/*.test.mjs'",
    "sonar": "./scripts/sonar-check.sh"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "workspace",
    "dsh-plugin"
  ]
}
